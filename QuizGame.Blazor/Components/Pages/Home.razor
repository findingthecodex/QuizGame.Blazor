@page "/"
@using MudBlazor

<div style="
    min-height: 92vh; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    text-align: center;">

    <div>
        <MudText Typo="Typo.h1" Class="mb-3">
            Welcome to QuizGame!
        </MudText>
        
        <MudText Typo="Typo.subtitle1" Class="mb-5">
