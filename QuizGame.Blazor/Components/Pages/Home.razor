@page "/"
@using MudBlazor
@inject NavigationManager Nav

<div style="
    min-height: 92vh; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    text-align: center;">

    <div>
        <MudText Typo="Typo.h1" Class="mb-3">
            Welcome to QuizGame!
        </MudText>
        
        <MudText Typo="Typo.subtitle1" Class="mb-5">
            Test your knowledge and have fun with our exciting quiz challenges! 🎉
        </MudText>

        <MudButton 
            Size="Size.Large" 
            Variant="Variant.Filled" 
            Color="Color.Primary"
            OnClick="@(() => Nav.NavigateTo("/categories"))"
            Style="padding: 16px 40px; font-size: 1.1rem; border-radius: 12px;">
    
            Start Quiz 🎮
        </MudButton>
        


    </div>

</div>

<!-- Copyright längst ner -->
<div style="
    margin-top: auto; 
    padding-bottom: 16px; 
    width: 100%;
    display: flex;
    justify-content: center;
    text-align: center;">
    
    <MudText Typo="Typo.caption" Color="Color.Secondary">
        © 2026 FindingTheCode. All rights reserved.
    </MudText>
</div>


