@page "/quiz/gaming"

@using MudBlazor

<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">
    🎮 Gaming Quiz
</MudText>

<MudCard Class="p-4" Style="max-width:600px; margin:auto;">

    <MudText Typo="Typo.h6" Class="mb-3">
        What year was PlayStation 1 released?
    </MudText>

    <MudStack Spacing="2">
        <MudButton Variant="Variant.Outlined">1994</MudButton>
        <MudButton Variant="Variant.Outlined">1996</MudButton>
        <MudButton Variant="Variant.Outlined">2000</MudButton>
        <MudButton Variant="Variant.Outlined">2003</MudButton>
    </MudStack>

</MudCard>